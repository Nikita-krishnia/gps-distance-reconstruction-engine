# ==============================================================================
# GPS Distance Reconstruction Engine - Environment Configuration Template
#
# IMPORTANT: Never commit real secrets to git.
# Copy this template to .env and change values before running:
#   cp .env.example .env
# ==============================================================================

# Application HTTP Port (default 8080; use 8081 if 8080 is reserved by Windows Hyper-V)
APP_PORT=8080

# Database Configuration (PostgreSQL 17)
DB_PORT=5432
DB_NAME=gps_db
DB_USERNAME=gps_user
DB_PASSWORD=gps_password

# Authentication & JWT Configuration
# Required: 256-bit (32+ bytes) secret key for HMAC-SHA256 signature verification
JWT_SECRET=ChangeThisToASecretKeyWithAtLeast32BytesForHmacSha256!

# User Seeding (Dev / Demo environments)
# When SEED_USERS=true, seed accounts are provisioned on startup if empty:
#   admin (ADMIN), operator (OPERATOR), employee1 (EMPLOYEE, tenant-a), employee2 (EMPLOYEE, tenant-b)
SEED_USERS=true
SEED_PASSWORD=MoveInSync@2026!

# Operational & Fault Injection Controls
# Enable fault-injection endpoint for live demos (/api/v1/admin/demo/provider-failure)
DEMO_FAULT_INJECTION=false

# Background Recompute Scheduler
# Period in seconds between automatic recomputations of DEGRADED trips
RECOMPUTE_ENABLED=true
RECOMPUTE_INTERVAL_SECONDS=30

# Routing Engine Configuration
# Providers: fake (deterministic, no network needed) or osrm
ROUTING_PROVIDER=fake
ROUTING_CACHE_ENABLED=true
ROUTING_BREAKER_OPEN_SECONDS=30

# Optional OSRM settings (active when ROUTING_PROVIDER=osrm)
# OSRM_BASE_URL=http://localhost:5000
# OSRM_API_KEY=

# Structured Logging
# Options: ecs (Elastic Common Schema JSON), logstash, or leave empty for standard text logs
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
